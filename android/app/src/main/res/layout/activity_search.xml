<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingEnd="40dp"
    android:paddingTop="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel_bold"
            android:text="Search"
            android:textColor="@color/title_cream"
            android:textSize="24sp"
            android:layout_marginEnd="22dp" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/row_item_bg"
            android:hint="Series or movie title…"
            android:textColor="@color/row_item_text"
            android:textColorHint="@color/row_item_text_dim"
            android:textSize="17sp"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:id="@+id/searchBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/btn_primary"
            android:focusable="true"
            android:clickable="true"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="11dp" android:paddingBottom="11dp"
            android:text="⌕  Search"
            android:textColor="@color/btn_primary_text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/searchStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:paddingBottom="16dp"
        android:descendantFocusability="afterDescendants" />
</LinearLayout>
