<?xml version="1.0" encoding="utf-8"?>
<!-- The compact tile, for the two grids: picking your name on first run,
     and picking a picture. Same structure and the same round focus ring as
     the full-size tile, just smaller.

     It exists as its own layout because the sizes used to be rewritten in
     Kotlin after inflating the big one, which left the two grids subtly
     inconsistent with each other and with the screen they sat on. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="7dp"
    android:layout_marginEnd="7dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:clickable="true"
    android:focusable="true"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp">

        <TextView
            android:id="@+id/pAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/avatar_circle"
            android:duplicateParentState="true"
            android:fontFamily="@font/cinzel_bold"
            android:gravity="center"
            android:textColor="#1a1408"
            android:textSize="28sp" />

        <ImageView
            android:id="@+id/pAvatarImg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@string/app_name" />

        <View
            android:id="@+id/pRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/avatar_ring"
            android:duplicateParentState="true" />
    </FrameLayout>

    <TextView
        android:id="@+id/pName"
        android:layout_width="116dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:duplicateParentState="true"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/profile_name"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
