<?xml version="1.0" encoding="utf-8"?>
<!-- OTTOMAN controller: Cinzel titles over a gold manuscript rule. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View android:id="@id/exo_controls_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_player" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingBottom="26dp"
        android:layoutDirection="ltr">

        <ImageView
            android:layout_width="240dp"
            android:layout_height="8dp"
            android:layout_marginBottom="10dp"
            android:src="@drawable/ott_divider"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/ctlTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel_bold"
            android:textColor="@color/title_cream"
            android:textSize="21sp"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#cc000000"
            android:shadowRadius="12" />

        <TextView
            android:id="@+id/ctlSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_soft"
            android:textSize="12sp"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#cc000000"
            android:shadowRadius="8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cinzel_medium"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:includeFontPadding="false" />

            <androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                app:bar_height="3dp"
                app:played_color="@color/accent"
                app:scrubber_color="@color/title_cream"
                app:buffered_color="#66e0b34d"
                app:unplayed_color="#33ffffff"
                app:scrubber_enabled_size="11dp"
                app:scrubber_dragged_size="15dp" />

            <TextView android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cinzel_medium"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/ctlHints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="OK  pause   ·   ◀ ▶  seek 10 s   ·   ▲  sources   ·   ▼  tracks   ·   0  diagnostics"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageButton android:id="@id/exo_play_pause"
        style="@style/ExoStyledControls.Button.Center.PlayPause"
        android:layout_gravity="center" />
</merge>
