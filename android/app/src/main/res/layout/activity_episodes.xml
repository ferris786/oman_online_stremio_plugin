<?xml version="1.0" encoding="utf-8"?>
<!-- Series page: backdrop, title/meta/synopsis with Resume + Season menu,
     horizontal episode cards along the bottom -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/epBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name" />

    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_left" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_bottom" />

    <LinearLayout
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="36dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/epLogo"
            android:layout_width="300dp"
            android:layout_height="90dp"
            android:scaleType="fitStart"
            android:visibility="gone"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/seriesName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel_bold"
            android:textColor="@color/title_cream"
            android:textSize="34sp"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#cc000000"
            android:shadowRadius="16" />

        <TextView
            android:id="@+id/epMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_soft"
            android:textSize="13sp"
            android:textStyle="bold"
            android:shadowColor="#cc000000"
            android:shadowRadius="8" />

        <TextView
            android:id="@+id/epSynopsis"
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_soft"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:shadowColor="#cc000000"
            android:shadowRadius="8" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnResume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="22dp" android:paddingEnd="22dp"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:text="▶  Play"
                android:textColor="@color/btn_primary_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSeason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="18dp" android:paddingEnd="18dp"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:text="Season 1  ▾"
                android:textColor="@color/btn_primary_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTrailer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="18dp" android:paddingEnd="18dp"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:text="▶  Trailer"
                android:textColor="@color/btn_primary_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/epRowHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="64dp"
            android:textColor="@color/text_soft"
            android:textSize="12sp"
            android:textStyle="bold"
            android:shadowColor="#cc000000"
            android:shadowRadius="8" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/episodeList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingStart="58dp"
            android:paddingEnd="40dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:descendantFocusability="afterDescendants" />
    </LinearLayout>
</FrameLayout>
