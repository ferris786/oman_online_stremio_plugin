<?xml version="1.0" encoding="utf-8"?>
<!-- Episode card: 16:9 still with number / state / progress, then title,
     runtime and a two-line overview -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="214dp"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:focusable="true"
    android:clickable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/epStillFrame"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:duplicateParentState="true"
            android:foreground="@drawable/focus_ring">

            <ImageView
                android:id="@+id/epStill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/epNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="7dp"
                android:fontFamily="@font/cinzel_bold"
                android:textColor="@color/title_cream"
                android:textSize="18sp"
                android:shadowColor="#000000"
                android:shadowRadius="8" />

            <TextView
                android:id="@+id/epState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="7dp"
                android:background="@drawable/chip_new"
                android:paddingStart="6dp" android:paddingEnd="6dp"
                android:paddingTop="2dp" android:paddingBottom="2dp"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/epProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="bottom"
                android:max="100"
                android:progressDrawable="@drawable/progress_gold"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/epName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/epDur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/epOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#b5b0a4"
            android:textSize="10.5sp"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:minLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
