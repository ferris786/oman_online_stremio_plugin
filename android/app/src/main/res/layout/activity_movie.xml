<?xml version="1.0" encoding="utf-8"?>
<!-- Movie page.
     The actions live on TWO rows and every button is single-line. Six of
     them on one row needed ~950dp inside a 560dp column, so they were
     squeezed until their labels wrapped (the "crazy tall" Trailer button),
     Reviews was pushed off the right edge, and the cast line below them
     fell off the bottom of the screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/mBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name" />

    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_left" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_bottom" />

    <LinearLayout
        android:layout_width="660dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="64dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/mLogo"
            android:layout_width="300dp"
            android:layout_height="92dp"
            android:scaleType="fitStart"
            android:visibility="gone"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/mTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel_bold"
            android:textColor="@color/title_cream"
            android:textSize="34sp"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#cc000000"
            android:shadowRadius="16" />

        <LinearLayout
            android:id="@+id/mBadges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/mRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_gold"
                android:paddingStart="7dp" android:paddingEnd="7dp"
                android:paddingTop="2dp" android:paddingBottom="2dp"
                android:singleLine="true"
                android:textColor="@color/accent_dark"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/mYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:singleLine="true"
                android:textColor="@color/text_soft"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mRuntime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:singleLine="true"
                android:textColor="@color/text_soft"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mGenres"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- cast sits with the other facts, ABOVE the buttons, so it can
             never be pushed off the bottom by them -->
        <TextView
            android:id="@+id/mCast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/mDesc"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_soft"
            android:textSize="13.5sp"
            android:lineSpacingExtra="3dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:shadowColor="#cc000000"
            android:shadowRadius="8" />

        <!-- primary actions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="24dp" android:paddingEnd="24dp"
                android:paddingTop="11dp" android:paddingBottom="11dp"
                android:singleLine="true"
                android:text="▶  Play"
                android:textColor="@color/btn_primary_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mSources"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="20dp" android:paddingEnd="20dp"
                android:paddingTop="11dp" android:paddingBottom="11dp"
                android:singleLine="true"
                android:text="≡  Sources"
                android:textColor="@color/btn_primary_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- secondary actions -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mMyList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingTop="9dp" android:paddingBottom="9dp"
                android:singleLine="true"
                android:text="＋  My List"
                android:textColor="@color/btn_primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mCollection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingTop="9dp" android:paddingBottom="9dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="230dp"
                android:text="◈  Collection"
                android:textColor="@color/btn_primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mTrailer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingTop="9dp" android:paddingBottom="9dp"
                android:singleLine="true"
                android:text="▶  Trailer"
                android:textColor="@color/btn_primary_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/mReviews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingTop="9dp" android:paddingBottom="9dp"
                android:singleLine="true"
                android:text="★  Reviews"
                android:textColor="@color/btn_primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/mStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
