<?xml version="1.0" encoding="utf-8"?>
<!-- TERMINAL controller: DOS transport panel docked at the bottom. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View android:id="@id/exo_controls_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_player" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="42dp"
        android:layout_marginEnd="42dp"
        android:layout_marginBottom="26dp"
        android:background="@drawable/term_panel"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layoutDirection="ltr">

        <TextView
            android:id="@+id/ctlTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vt323"
            android:textColor="@color/term_yellow"
            android:textSize="27sp"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/ctlSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vt323"
            android:textColor="@color/term_cyan"
            android:textSize="17sp"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:textColor="@color/term_grey"
                android:textSize="18sp"
                android:includeFontPadding="false" />

            <androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:bar_height="9dp"
                app:touch_target_height="22dp"
                app:played_color="@color/term_yellow"
                app:scrubber_color="@color/term_white"
                app:buffered_color="#73557f7f"
                app:unplayed_color="#40ffffff"
                app:scrubber_enabled_size="10dp"
                app:scrubber_dragged_size="14dp" />

            <TextView android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:textColor="@color/term_grey"
                android:textSize="18sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/ctlHints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="@font/vt323"
            android:text="[OK] PAUSE   [&lt;&gt;] SEEK 10s   [^] SOURCES   [v] TRACKS   [CH+-] SWITCH   [0] DIAGNOSTICS"
            android:textColor="@color/term_grey"
            android:textSize="16sp"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageButton android:id="@id/exo_play_pause"
        style="@style/ExoStyledControls.Button.Center.PlayPause"
        android:layout_gravity="center" />
</merge>
