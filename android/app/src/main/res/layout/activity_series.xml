<?xml version="1.0" encoding="utf-8"?>
<!-- Home: full-bleed backdrop, left rail, billboard, then horizontal rows
     that scroll up over the billboard (Netflix grammar). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name" />

    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_left" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_bottom" />

    <!-- Billboard -->
    <LinearLayout
        android:id="@+id/billboard"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="92dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bbChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_new"
            android:paddingStart="8dp" android:paddingEnd="8dp"
            android:paddingTop="3dp" android:paddingBottom="3dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/bbLogo"
            android:layout_width="320dp"
            android:layout_height="96dp"
            android:layout_marginTop="8dp"
            android:scaleType="fitStart"
            android:visibility="gone"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/bbTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/cinzel_bold"
            android:textColor="@color/title_cream"
            android:textSize="42sp"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#cc000000"
            android:shadowRadius="18" />

        <TextView
            android:id="@+id/bbMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_soft"
            android:textSize="13sp"
            android:textStyle="bold"
            android:shadowColor="#cc000000"
            android:shadowRadius="8" />

        <TextView
            android:id="@+id/bbSynopsis"
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_soft"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#cc000000"
            android:shadowRadius="8" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bbPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="22dp" android:paddingEnd="22dp"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:text="▶  Play"
                android:textColor="@color/btn_primary_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bbSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="22dp" android:paddingEnd="22dp"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:text="ⓘ  Episodes"
                android:textColor="@color/btn_primary_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Rows -->
    <com.kmk.turkishtv.SnapScrollView
        android:id="@+id/rowsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="296dp"
        android:paddingBottom="200dp"
        android:overScrollMode="never"
        android:focusable="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/rowsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </com.kmk.turkishtv.SnapScrollView>

    <!-- Left rail -->
    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel_bold"
            android:text="W"
            android:textColor="@color/accent"
            android:textSize="24sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/railHome"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rail_item"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="⌂"
            android:textColor="@color/rail_icon_text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/railSpin"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rail_item"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="✸"
            android:textColor="@color/rail_icon_text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/railSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rail_item"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="⌕"
            android:textColor="@color/rail_icon_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/railSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rail_item"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/rail_icon_text"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Cinematic splash: full-bleed artwork (carries the WAHAB TV title),
         slow Ken Burns zoom, caption in the open sky at top-right; dissolves
         into the billboard -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/splashImg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0"
            android:src="@drawable/splash_bg"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:id="@+id/splashText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="72dp"
            android:gravity="end"
            android:orientation="vertical"
            android:alpha="0">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TURKISH SERIES"
                android:textColor="#f2e6c9"
                android:textSize="22sp"
                android:letterSpacing="0.34"
                android:shadowColor="#000000"
                android:shadowRadius="10" />

            <View
                android:layout_width="150dp"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:background="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="by KMK"
                android:textColor="#c8c8cf"
                android:textSize="15sp"
                android:letterSpacing="0.16"
                android:shadowColor="#000000"
                android:shadowRadius="8" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
