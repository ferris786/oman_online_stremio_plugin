<?xml version="1.0" encoding="utf-8"?>
<!-- Home: full-bleed backdrop, left rail, billboard, then horizontal rows
     that scroll up over the billboard (Netflix grammar). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name" />

    <!-- colour taken from whatever artwork is showing; see Hue.kt -->
    <View
        android:id="@+id/hueWash"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_left" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_bottom" />

    <!-- Billboard -->
    <LinearLayout
        android:id="@+id/billboard"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="92dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bbChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_new"
            android:paddingStart="8dp" android:paddingEnd="8dp"
            android:paddingTop="3dp" android:paddingBottom="3dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/bbLogo"
            android:layout_width="320dp"
            android:layout_height="96dp"
            android:layout_marginTop="8dp"
            android:scaleType="fitStart"
            android:visibility="gone"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/bbTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/cinzel_bold"
            android:textColor="@color/title_cream"
            android:textSize="42sp"
            android:lineSpacingMultiplier="0.95"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#cc000000"
            android:shadowRadius="18" />

        <TextView
            android:id="@+id/bbMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_soft"
            android:textSize="13sp"
            android:textStyle="bold"
            android:shadowColor="#cc000000"
            android:shadowRadius="8" />

        <TextView
            android:id="@+id/bbSynopsis"
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_soft"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#cc000000"
            android:shadowRadius="8" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bbPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="22dp" android:paddingEnd="22dp"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:text="▶  Play"
                android:textColor="@color/btn_primary_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/bbSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/btn_primary"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="22dp" android:paddingEnd="22dp"
                android:paddingTop="10dp" android:paddingBottom="10dp"
                android:text="ⓘ  Episodes"
                android:textColor="@color/btn_primary_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Rows -->
    <com.kmk.turkishtv.SnapScrollView
        android:id="@+id/rowsScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="296dp"
        android:paddingBottom="200dp"
        android:overScrollMode="never"
        android:focusable="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/rowsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </com.kmk.turkishtv.SnapScrollView>

    <!-- Left sidebar.
         It used to be a 40dp strip of glyphs, which read as a row of
         floating symbols rather than navigation. It is now a real panel:
         its own ground, 56dp icon cells, 46dp rows, and the profile at the
         top where the person using it belongs. Widths are animated by
         SeriesActivity between RAIL_W_REST and RAIL_W_OPEN - labels only
         appear once it has focus, so at rest it still gives the artwork
         the whole screen. -->
    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="84dp"
        android:layout_height="match_parent"
        android:background="@drawable/rail_panel"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp">

        <!-- who is watching; opens the profile picker -->
        <LinearLayout
            android:id="@+id/railProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/rail_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/railAvatar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:background="@drawable/avatar_circle"
                    android:duplicateParentState="true"
                    android:fontFamily="@font/cinzel_bold"
                    android:gravity="center"
                    android:text="W"
                    android:textColor="#1a1408"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/railAvatarImg"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="@string/app_name" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/railProfileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/railProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:singleLine="true"
                    android:text="Wahab"
                    android:textColor="@color/rail_icon_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/railProfileSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:singleLine="true"
                    android:text="Switch profile"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/rail_divider" />

        <LinearLayout
            android:id="@+id/railHome"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rail_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:duplicateParentState="true"
                android:gravity="center"
                android:text="⌂"
                android:textColor="@color/rail_icon_text"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/railHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:text="Home"
                android:textColor="@color/rail_icon_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/railTurkish"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rail_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:duplicateParentState="true"
                android:gravity="center"
                android:text="☾"
                android:textColor="@color/rail_icon_text"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/railTurkishLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:text="Turkish"
                android:textColor="@color/rail_icon_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/railTv"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rail_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:duplicateParentState="true"
                android:gravity="center"
                android:text="▣"
                android:textColor="@color/rail_icon_text"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/railTvLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:text="TV"
                android:textColor="@color/rail_icon_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/railMovies"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rail_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:duplicateParentState="true"
                android:gravity="center"
                android:text="▶"
                android:textColor="@color/rail_icon_text"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/railMoviesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:text="Movies"
                android:textColor="@color/rail_icon_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/railCollections"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rail_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:duplicateParentState="true"
                android:gravity="center"
                android:text="◈"
                android:textColor="@color/rail_icon_text"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/railCollectionsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:text="My Lists"
                android:textColor="@color/rail_icon_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/railSpin"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rail_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:duplicateParentState="true"
                android:gravity="center"
                android:text="✸"
                android:textColor="@color/rail_icon_text"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/railSpinLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:text="The Reel"
                android:textColor="@color/rail_icon_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/railSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rail_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:duplicateParentState="true"
                android:gravity="center"
                android:text="⌕"
                android:textColor="@color/rail_icon_text"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/railSearchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:text="Search"
                android:textColor="@color/rail_icon_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/railSettings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rail_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:duplicateParentState="true"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/rail_icon_text"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/railSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:text="Settings"
                android:textColor="@color/rail_icon_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- pushes nothing; keeps the column top-aligned if the TV is tall -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="false" />
    </LinearLayout>

    <!-- Cinematic splash: full-bleed artwork (carries the WAHAB TV title),
         slow Ken Burns zoom, caption in the open sky at top-right; dissolves
         into the billboard -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/splashImg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0"
            android:src="@drawable/splash_bg"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:id="@+id/splashText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="72dp"
            android:gravity="end"
            android:orientation="vertical"
            android:alpha="0">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TURKISH SERIES"
                android:textColor="#f2e6c9"
                android:textSize="22sp"
                android:letterSpacing="0.34"
                android:shadowColor="#000000"
                android:shadowRadius="10" />

            <View
                android:layout_width="150dp"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:background="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="by KMK"
                android:textColor="#c8c8cf"
                android:textSize="15sp"
                android:letterSpacing="0.16"
                android:shadowColor="#000000"
                android:shadowRadius="8" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
