<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="22dp">

            <View
                android:layout_width="6dp"
                android:layout_height="34dp"
                android:background="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/app_tagline"
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:letterSpacing="0.1" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_author"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/continueHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="28dp"
            android:paddingTop="14dp"
            android:text="Continue Watching"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/continueRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone" />

        <!-- Slim bar shown while the Continue row is collapsed (browsing series) -->
        <TextView
            android:id="@+id/continueBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/row_selector"
            android:focusable="true"
            android:clickable="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="▸  Continue Watching"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="28dp"
            android:paddingTop="18dp"
            android:text="All Series"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <!-- Cinematic splash: full-bleed artwork (carries the WAHAB TV title),
         slow Ken Burns zoom, caption in the open sky at top-right -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/splashImg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0"
            android:src="@drawable/splash_bg"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:id="@+id/splashText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="72dp"
            android:gravity="end"
            android:orientation="vertical"
            android:alpha="0">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TURKISH SERIES"
                android:textColor="#f2e6c9"
                android:textSize="22sp"
                android:letterSpacing="0.34"
                android:shadowColor="#000000"
                android:shadowRadius="10" />

            <View
                android:layout_width="150dp"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:background="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="by KMK"
                android:textColor="#c8c8cf"
                android:textSize="15sp"
                android:letterSpacing="0.16"
                android:shadowColor="#000000"
                android:shadowRadius="8" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
