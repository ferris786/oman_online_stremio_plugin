<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait poster card: 2:3, white focus ring as foreground, optional chip -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="118dp"
    android:layout_height="177dp"
    android:layout_margin="5dp"
    android:focusable="true"
    android:clickable="true"
    android:foreground="@drawable/focus_ring">

    <ImageView
        android:id="@+id/poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name" />

    <TextView
        android:id="@+id/chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/chip_new"
        android:paddingStart="6dp" android:paddingEnd="6dp"
        android:paddingTop="2dp" android:paddingBottom="2dp"
        android:text="NEW"
        android:textColor="@color/white"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:visibility="gone" />

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#b3000000"
        android:padding="6dp"
        android:textColor="@color/text"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone" />
</FrameLayout>
