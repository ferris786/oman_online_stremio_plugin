<?xml version="1.0" encoding="utf-8"?>
<!-- A frosted pane. The blur itself is applied at runtime with RenderEffect
     (PlayerActivity.applyGlass); this is the tint and edge that sit over it,
     and the whole appearance on the older devices where blur is unavailable. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#30ffffff" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="@color/glass_edge" />
</shape>
