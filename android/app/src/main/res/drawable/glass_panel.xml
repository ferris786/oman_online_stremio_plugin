<?xml version="1.0" encoding="utf-8"?>
<!-- Dark translucent pane with a light hairline, so text on it reads over
     any frame. See glass_bar for why this is not a white frosting. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#d60a0a0e" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="@color/glass_edge" />
</shape>
