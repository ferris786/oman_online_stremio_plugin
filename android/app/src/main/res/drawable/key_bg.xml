<?xml version="1.0" encoding="utf-8"?>
<!-- One key on the on-screen keyboard. Focus is a solid cream fill, the
     same signal the sidebar uses, so it reads from across a room. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#f4efe2" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1e1e26" />
            <corners android:radius="7dp" />
            <stroke android:width="1dp" android:color="#2e2e38" />
        </shape>
    </item>
</selector>
