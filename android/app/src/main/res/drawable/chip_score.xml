<?xml version="1.0" encoding="utf-8"?>
<!-- The score badge on a poster. Dark and semi-opaque rather than gold:
     it sits on top of artwork of every possible colour, so it has to carry
     its own contrast instead of borrowing the card's. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#cc0b0b0f" />
    <corners android:radius="5dp" />
    <stroke android:width="1dp" android:color="#33ffffff" />
</shape>
