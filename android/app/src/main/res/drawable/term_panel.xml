<?xml version="1.0" encoding="utf-8"?>
<!-- DOS double-line frame: outer rule, gap, inner rule -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#e6000208" />
            <stroke android:width="2dp" android:color="@color/term_cyan" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="@color/term_cyan" />
        </shape>
    </item>
</layer-list>
