<?xml version="1.0" encoding="utf-8"?>
<!-- The controller's pane.
     A DARK translucent material, not a white frosting: white over a bright
     frame left the text unreadable on a real television. Android hex is
     AARRGGBB, so these are 86% and 68% opaque near-black — the picture
     still shows through, but white type always has something to sit on. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#db070709"
                android:endColor="#ad0d0d12" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#59ffffff" />
        </shape>
    </item>
</layer-list>
