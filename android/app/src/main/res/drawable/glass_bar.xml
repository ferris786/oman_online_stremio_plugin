<?xml version="1.0" encoding="utf-8"?>
<!-- The controller's own pane: square to the screen edges at the bottom,
     rounded only on top, with a bright hairline where it meets the picture. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26ffffff" />
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#59ffffff" />
        </shape>
    </item>
</layer-list>
