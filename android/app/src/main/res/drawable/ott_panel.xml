<?xml version="1.0" encoding="utf-8"?>
<!-- Manuscript-style gold border: hairline outer, heavier inner rule -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#f0120d08" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#8ce0b34d" />
        </shape>
    </item>
</layer-list>
