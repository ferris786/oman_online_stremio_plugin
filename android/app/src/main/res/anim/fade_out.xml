<?xml version="1.0" encoding="utf-8"?>
<!-- The page being left recedes very slightly instead of cutting away. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha android:fromAlpha="1.0" android:toAlpha="0.0" android:duration="200"
        android:interpolator="@android:interpolator/decelerate_quad" />
    <scale android:fromXScale="1.0" android:toXScale="1.03"
        android:fromYScale="1.0" android:toYScale="1.03"
        android:pivotX="50%p" android:pivotY="50%p"
        android:duration="240" android:interpolator="@android:interpolator/decelerate_quad" />
</set>
