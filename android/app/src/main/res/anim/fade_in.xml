<?xml version="1.0" encoding="utf-8"?>
<!-- Opening a page: it grows in from just under full size, so a poster reads as expanding into the screen rather than being replaced. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="220"
        android:interpolator="@android:interpolator/decelerate_quad" />
    <scale android:fromXScale="0.96" android:toXScale="1.0"
        android:fromYScale="0.96" android:toYScale="1.0"
        android:pivotX="50%p" android:pivotY="50%p"
        android:duration="260" android:interpolator="@android:interpolator/decelerate_quad" />
</set>
